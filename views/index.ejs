<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CoreKeys - Home</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #0a0a0a; /* Tamna podloga */
            background-image: 
                linear-gradient(45deg, transparent 49%, #ff0000 50%, #ff0000 51%, transparent 52%),
                linear-gradient(-45deg, transparent 49%, #ff0000 50%, #ff0000 51%, transparent 52%),
                radial-gradient(circle, #1a1a1a 1px, transparent 1px);
            background-size: 100% 100%, 100% 100%, 4px 4px; /* Karbon efekat sa crvenim linijama */
            color: white;
            font-family: 'Segoe UI', sans-serif;
            height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        h1 {
            font-size: 4rem;
            text-transform: uppercase;
            letter-spacing: 5px;
            text-shadow: 0 0 20px #ff0000;
            margin-bottom: 50px;
        }
        .main-container {
            display: flex;
            gap: 40px;
        }
        .box {
            width: 250px;
            height: 250px;
            background: rgba(0, 0, 0, 0.8);
            border: 3px solid #ff0000;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: bold;
            text-transform: uppercase;
            cursor: pointer;
            transition: 0.4s;
            text-decoration: none;
            color: white;
            box-shadow: 0 0 15px rgba(255, 0, 0, 0.2);
        }
        .box:hover {
            transform: scale(1.1);
            background: #ff0000;
            box-shadow: 0 0 40px #ff0000;
            color: black;
        }
    </style>
</head>
<body>
    <h1>COREKEYS</h1>
    <div class="main-container">
        <a href="/kategorija/windows" class="box">WINDOWS</a>
        <a href="/kategorija/office" class="box">OFFICE</a>
    </div>
</body>
</html>